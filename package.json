{
  "name": "dsh-plugin-terminal-upgrades",
  "version": "0.2.0",
  "private": false,
  "type": "module",
  "description": "Terminal upgrades for DeepSeek Harness: hold Option over a terminal link to underline it, and click to open it in your browser. The trigger key is configurable.",
  "license": "MIT",
  "author": "Jeremy Tenjo",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "deepseek",
    "terminal",
    "links",
    "url"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jeremytenjo/dsh-plugin-terminal-upgrades.git"
  },
  "homepage": "https://github.com/jeremytenjo/dsh-plugin-terminal-upgrades#readme",
  "bugs": {
    "url": "https://github.com/jeremytenjo/dsh-plugin-terminal-upgrades/issues"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "icon.svg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": []
    }
  },
  "devDependencies": {
    "esbuild": "0.25.10",
    "jsdom": "29.1.1"
  },
  "scripts": {
    "build": "node scripts/build-client.mjs",
    "test": "node --test test/*.test.mjs"
  }
}
